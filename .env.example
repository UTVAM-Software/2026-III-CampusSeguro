# Copia este archivo a `.env` y ajusta lo que haga falta:
#
#     cp .env.example .env
#
# `.env` NO se sube al repositorio -lo impide .gitignore-, y es a proposito:
# ahi dentro acaban la clave secreta y, el dia que lo haya, la contrasena
# del servidor de correo.

# --- Obligatorio en desarrollo ---

# Con DEBUG apagado el proyecto exige un servidor de correo y no arranca sin
# el, porque sin correo nadie puede recuperar su contrasena. En local se
# imprime en la terminal, asi que esto tiene que estar encendido.
DEBUG=True

# Firma las cookies de sesion y los enlaces de recuperar contrasena. En
# desarrollo vale cualquier cadena larga; en produccion tiene que ser
# secreta y distinta, y cambiarla cierra todas las sesiones abiertas.
SECRET_KEY=desarrollo-cambiar-esto-por-algo-largo-y-al-azar

# --- Solo fuera de desarrollo ---
#
# Con DEBUG=False, EMAIL_HOST es obligatorio: el proyecto no arranca sin el.
#
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Campus Seguro <no-responder@tudominio.mx>

# El servicio de rutas a pie. Por omision, la instancia de peaton de FOSSGIS.
# NO la de demostracion de OSRM: aquella ignora el perfil y devuelve rutas de
# coche aunque se le pida `foot`.
#
# OSRM_HOST=https://routing.openstreetmap.de/routed-foot
